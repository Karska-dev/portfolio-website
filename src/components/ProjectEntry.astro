---
// One entry in the homepage's "Projects in action" list.

import type { ListedProject } from '../lib/projects';
import { keepTogether } from '../lib/text';

interface Props {
  project: ListedProject;
}

const { project } = Astro.props;
const { data } = project;
const links = data.links.filter((link) => link.showInList);
---

<article class="project">
  <h3 class="project__name">
    {/* A line break between a tag and a { } expression is dropped, so the
        space before the label is written out explicitly. */}
    <a href={project.url}>{data.name}</a>{' '}
    {data.comingSoon && <span class="mono">/ coming soon</span>}
  </h3>
  <p class="muted" set:html={keepTogether(data.summary)} />
  {data.stack.length > 0 && <p class="project__stack mono">{data.stack.join(' / ')}</p>}
  {links.length > 0 && (
    <p class="text-links">
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener">{link.label} ↗</a>
      ))}
    </p>
  )}
</article>
